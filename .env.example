# Browser-safe values (Supabase publishable/anon key only)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API-only values. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Supabase Postgres connection string. Prefer the transaction pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_LOGGING=false
# Inject these API-only values from the installation's secret manager. Generate a
# distinct random 32-byte secret per installation and key version.
PATIENT_KEY_INSTALLATION_ID=
PATIENT_KEY_VERSION=1
PATIENT_KEY_SECRET_BASE64=
PORT=3001
WEB_ORIGIN=http://localhost:3000
