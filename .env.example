NEXT_PUBLIC_API_URL=same-origin

# Root npm run dev loads .env.local and passes private values only to the API.
# First-time local Supabase/owner setup: docs/runbooks/local-development.md.
# Use the Postgres connection string. Prefer the transaction pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_LOGGING=false
# Inject these API-only values from the installation's secret manager. Generate a
# distinct random 32-byte secret per installation and key version.
PATIENT_KEY_INSTALLATION_ID=
PATIENT_KEY_VERSION=1
PATIENT_KEY_SECRET_BASE64=
AUTH_RATE_LIMIT_SECRET_BASE64=
AUTH_TRUST_PROXY_HOPS=0
# Dedicated AES-256 wrapping key for offline report data keys. Development uses
# an explicit built-in local-only value when this is omitted; production must set it.
OFFLINE_RECOVERY_KEY_VERSION=1
OFFLINE_RECOVERY_SECRET_BASE64=
# JSON object containing every non-retired offline wrapping-key version. Keep it
# in the deployment secret manager, never in source control.
OFFLINE_RECOVERY_WRAPPING_KEYS_JSON={}
# API port; the root startup helper always starts the web app on 3000.
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Optional suffix for short agency hostnames; defaults to WEB_ORIGIN hostname.
# AGENCY_BASE_DOMAIN=opentriage.org

# Local web edge (development and npm start); empty disables the landing host.
OPEN_TRIAGE_PUBLIC_SITE_HOST=localhost
# npm run dev derives this from API PORT; npm start uses this upstream directly.
OPEN_TRIAGE_API_UPSTREAM=http://127.0.0.1:3001

# API-only master wrapping keys from the installation secret manager. Agency
# credential keys are generated and rotated in Admin > Authentication.
OIDC_CREDENTIAL_KEY_VERSION=1
OIDC_CREDENTIAL_KEYS_JSON={}
