{
  "name": "@open-triage/web",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "predev": "npm run build -w @open-triage/contracts && tsx scripts/generate-demo-fixtures.ts && tsx scripts/build-service-worker.ts",
    "dev": "next dev",
    "prebuild": "npm run build -w @open-triage/contracts && tsx scripts/generate-demo-fixtures.ts --check && tsx scripts/build-service-worker.ts",
    "build": "next build",
    "serve:static": "node scripts/serve-static.mjs",
    "start": "npm run serve:static",
    "lint": "eslint .",
    "pretest": "npm run build -w @open-triage/contracts",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "generate:demo-fixtures": "tsx scripts/generate-demo-fixtures.ts",
    "check:demo-fixtures": "tsx scripts/generate-demo-fixtures.ts --check",
    "test:a11y": "playwright test --config playwright.config.ts accessibility-journey.spec.ts stationary-navigation.spec.ts stationary-completion-journey.spec.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:critical": "playwright test --config playwright.critical.config.ts",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-triage/contracts": "0.1.0",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
