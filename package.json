{
  "name": "open-triage",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @open-triage/web\" \"npm run dev -w @open-triage/api\"",
    "build": "npm run audit:nemsis-catalog && npm run check:nemsis-catalog-guardrails && npm run check:stationary-layout && npm run check:database && npm run build -w @open-triage/contracts && npm run build -w @open-triage/api && npm run build -w @open-triage/web",
    "generate:nemsis-data-model": "node apps/web/scripts/generate-nemsis-data-model.mjs",
    "generate:stationary-layout": "node apps/web/scripts/generate-stationary-layout.mjs",
    "generate:database": "npm run generate -w @open-triage/database",
    "check:nemsis-data-model": "node apps/web/scripts/generate-nemsis-data-model.mjs --check",
    "check:stationary-layout": "node apps/web/scripts/generate-stationary-layout.mjs --check",
    "check:database": "npm run check -w @open-triage/database",
    "check:demo-fixtures": "npm run check:demo-fixtures -w @open-triage/web",
    "audit:nemsis-catalog": "node apps/web/scripts/audit-nemsis-catalog.mjs",
    "check:nemsis-catalog-guardrails": "node apps/web/scripts/check-nemsis-catalog-guardrails.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:workflow && npm run test --workspaces --if-present",
    "test:helm": "node --test deploy/helm/open-triage/tests/*.test.mjs",
    "test:workflow": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22" }
}
