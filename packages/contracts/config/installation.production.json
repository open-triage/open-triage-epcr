{
  "schemaVersion": "1.0.0",
  "signIn": {
    "brandText": "OpenTriage ePCR",
    "helperText": "Sign in with your agency-issued credentials."
  },
  "clinicalRetention": {
    "durationHours": 87600,
    "automaticDeletionEnabled": false
  },
  "authentication": {
    "sessionDurationMinutes": 720,
    "idleTimeoutMinutes": 30,
    "minimumPasswordLength": 12,
    "temporaryPasswordHours": 72
  },
  "offlineRecovery": {
    "windowHours": 24,
    "restartReauthenticationRequired": true
  },
  "exports": {
    "downloadsAllowed": true,
    "auditExportsAllowed": true,
    "configurationExportsAllowed": true
  }
}
