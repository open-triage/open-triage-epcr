{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-triage.org/schemas/installation-settings-1.0.0.json",
  "title": "OpenTriage installation settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signIn",
    "clinicalRetention",
    "authentication",
    "offlineRecovery",
    "exports"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "signIn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brandText", "helperText"],
      "properties": {
        "brandText": { "type": "string", "minLength": 1, "maxLength": 100 },
        "helperText": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "clinicalRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationHours", "automaticDeletionEnabled"],
      "properties": {
        "durationHours": { "type": "integer", "minimum": 1 },
        "automaticDeletionEnabled": { "type": "boolean" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionDurationMinutes", "idleTimeoutMinutes", "minimumPasswordLength", "temporaryPasswordHours"],
      "properties": {
        "sessionDurationMinutes": { "type": "integer", "minimum": 15 },
        "idleTimeoutMinutes": { "type": "integer", "minimum": 5 },
        "minimumPasswordLength": { "type": "integer", "minimum": 8 },
        "temporaryPasswordHours": { "type": "integer", "minimum": 1 }
      }
    },
    "offlineRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowHours", "restartReauthenticationRequired"],
      "properties": {
        "windowHours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "restartReauthenticationRequired": { "type": "boolean" }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadsAllowed", "auditExportsAllowed", "configurationExportsAllowed"],
      "properties": {
        "downloadsAllowed": { "type": "boolean" },
        "auditExportsAllowed": { "type": "boolean" },
        "configurationExportsAllowed": { "type": "boolean" }
      }
    }
  }
}
