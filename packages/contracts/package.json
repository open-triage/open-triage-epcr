{
  "name": "@open-triage/contracts",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./patient-key": { "types": "./patient-key.d.ts", "default": "./patient-key.mjs" },
    "./quality-rules": { "types": "./quality-rules.d.ts", "default": "./quality-rules.mjs" },
    "./quality-normalization-policy.json": "./quality-normalization-policy.json",
    "./encounter-document.schema-1.0.0.json": "./encounter-document.schema-1.0.0.json",
    "./dispatch-message.schema-1.0.0.json": "./dispatch-message.schema-1.0.0.json",
    "./installation-settings.schema-1.0.0.json": "./installation-settings.schema-1.0.0.json",
    "./config/*.json": "./config/*.json",
    "./examples/dispatch/*.json": "./examples/dispatch/*.json"
  },
  "scripts": {
    "generate:nemsis-ems-import": "node scripts/generate-nemsis-ems-import.mjs",
    "check:nemsis-ems-import": "node scripts/generate-nemsis-ems-import.mjs --check",
    "prebuild": "npm run check:nemsis-ems-import",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
