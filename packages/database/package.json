{
  "name": "@open-triage/database",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-nemsis-analytics.mjs",
    "check": "node scripts/generate-nemsis-analytics.mjs --check",
    "migrate": "npm run build -w @open-triage/api && node scripts/migrate.mjs",
    "migrate:runtime": "node scripts/migrate.mjs",
    "provision:workload-logins": "node scripts/provision-workload-logins.mjs",
    "bootstrap:synthetic": "npm run build -w @open-triage/contracts && npm run build -w @open-triage/api && npm run migrate && npm run load:catalog && npm run bootstrap:synthetic:runtime && npm run seed:validation && npm run seed:install-definitions",
    "bootstrap:synthetic:runtime": "node scripts/bootstrap-synthetic-installation.mjs",
    "reset:development": "npm run build -w @open-triage/contracts && npm run build -w @open-triage/api && node scripts/reset-development-database.mjs",
    "load:catalog": "node scripts/load-nemsis-catalog.mjs",
    "seed:validation": "node scripts/seed-initial-validation-versions.mjs",
    "seed:install-definitions": "npm run build -w @open-triage/api && node scripts/seed-install-definitions.mjs",
    "reset:unsigned-clinical": "node scripts/reset-unsigned-clinical-work.mjs",
    "project": "node scripts/project-analytics.mjs",
    "project:watch": "node --env-file-if-exists=../../.env.local scripts/watch-analytics.mjs",
    "rotate:patient-keys": "node scripts/rotate-patient-keys.mjs",
    "rotate:offline-recovery-keys": "node scripts/rotate-offline-recovery-keys.mjs",
    "project:health": "node scripts/projection-health.mjs",
    "retention": "node scripts/retention.mjs",
    "feedback:review": "node scripts/feedback-review.mjs",
    "feedback:review:context": "node scripts/feedback-review-context.mjs",
    "feedback:expire-diagnostics": "node scripts/expire-feedback-diagnostics.mjs",
    "purge:synthetic": "node scripts/purge-synthetic-records.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:replica": "node scripts/verify-reporting-replica.mjs",
    "scale:test:ci": "node scripts/run-scale-tests.mjs --profile ci --output artifacts/scale-test-ci.json",
    "scale:test:production": "node scripts/run-scale-tests.mjs --profile production --output artifacts/scale-test-production.json",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "npm run build -w @open-triage/api && REQUIRE_DATABASE_INTEGRATION=1 node --test tests/postgres.integration.test.mjs",
    "audit:localization": "node scripts/audit-catalog-localization.mjs",
    "audit:form-localization": "node scripts/audit-form-validation-localization.mjs",
    "install:synthetic:runtime": "node scripts/migrate.mjs && node scripts/load-nemsis-catalog.mjs && node scripts/bootstrap-synthetic-installation.mjs && node scripts/seed-initial-validation-versions.mjs && node scripts/seed-install-definitions.mjs"
  },
  "dependencies": {
    "@open-triage/contracts": "0.1.0",
    "pg": "^8.23.0"
  }
}
